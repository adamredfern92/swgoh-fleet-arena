# SWGOH Fleet Analysis Configuration

# SWGOH.GG API Key (get from https://swgoh.gg/api/)
SWGOH_API_KEY=SWGOHGG_API_KEY

# GAC Season Numbers (comma-separated list, e.g., "73,74,75")
# These will be converted to full season IDs: CHAMPIONSHIPS_GRAND_ARENA_GA2_EVENT_SEASON_{number}
SEASON_NUMBERS=74

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

